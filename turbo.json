{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "ANDROID_SDK_ROOT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "sync": {
      "dependsOn": ["build"],
      "cache": false
    },
    "ios": {
      "dependsOn": ["sync"],
      "cache": false
    },
    "android": {
      "dependsOn": ["sync"],
      "cache": false
    },
    "dev:ios": {
      "cache": false,
      "persistent": true
    },
    "dev:android": {
      "cache": false,
      "persistent": true
    }
  }
}
